# ==============================================================================
# Relay Gateway Environment Configuration
# ==============================================================================

# Server Settings
RELAY_HOST=0.0.0.0
RELAY_PORT=8000
RELAY_LOG_LEVEL=INFO
RELAY_LOG_PROMPTS=false
RELAY_ADMIN_KEY=relay_admin_secret_key_12345

# Database Settings (SQLite single file via aiosqlite, WAL mode enabled)
DATABASE_PATH=relay.db

# Distributed State & Cache (Redis 7)
REDIS_URL=redis://localhost:6379/0

# Rate Limiting & Resilience
RELAY_RATE_LIMIT_ALGORITHM=token_bucket # or sliding_window
RELAY_CIRCUIT_FAILURE_THRESHOLD=0.5
RELAY_CIRCUIT_MIN_REQUESTS=5
RELAY_CIRCUIT_COOLDOWN_SECONDS=10.0
RELAY_CIRCUIT_HALF_OPEN_PROBES=3

# Response Cache
RELAY_CACHE_ENABLED=true
RELAY_CACHE_DEFAULT_TTL_SECONDS=3600

# Audit Logging & Cost Tracking (Off hot path)
RELAY_LOG_QUEUE_MAXSIZE=10000
RELAY_LOG_BATCH_SIZE=100
RELAY_LOG_FLUSH_INTERVAL_SECONDS=0.5

# Routing Configuration
RELAY_CONFIG_PATH=config/models.yaml

# Optional Real Upstream Provider API Keys (MockProvider is default when absent)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Next.js Dashboard Client Settings
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000
NEXT_PUBLIC_ADMIN_KEY=relay_admin_secret_key_12345

# Demo Client Keys (generated by python scripts/seed.py into .env.local)
DEMO_UNLIMITED_KEY=
DEMO_BUDGETED_KEY=

